<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push. "development" is right for debug builds and TestFlight from
	  Xcode; the release build needs "production", which Xcode normally
	  manages through a separate Release entitlements file. Both require
	  the Push Notifications capability on the App ID.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>

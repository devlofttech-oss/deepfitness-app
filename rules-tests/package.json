{
  "name": "deepfitness-rules-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Firestore and Storage security rules tests for Deep Fitness.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project deepfitess-app 'vitest run'",
